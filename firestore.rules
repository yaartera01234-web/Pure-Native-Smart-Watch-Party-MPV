rules_version = '2';

// Smart Watch Party — Firestore ke niyam.
// Firebase console -> Build -> Firestore Database -> Rules -> paste kar ke Publish.
//
// NOTE: abhi Firebase Auth nahi hai, is liye "kaun hai" cryptographically check nahi ho
// sakta. Collections aur data-shape ko sakhti se limit kiya gaya hai. Auth aane ke baad
// participants/code ownership ko UID ke saath bind karna chahiye.

service cloud.firestore {
  match /databases/{database}/documents {

    // 1) Messages: chats/{chatId}/msgs/{msgId}
    match /chats/{chatId}/msgs/{msgId} {
      allow read: if true;
      allow create: if isValidMsg(request.resource.data);
      allow update: if isValidMsg(request.resource.data);
      allow delete: if true;
    }

    // 2) Presence + optional FCM token.
    match /users/{name} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['online', 'seenAt', 'fcmToken'])
                   && (!('online' in request.resource.data) || request.resource.data.online is bool)
                   && (!('seenAt' in request.resource.data) || request.resource.data.seenAt is number)
                   && (!('fcmToken' in request.resource.data) ||
                       (request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() <= 4096));
    }

    // 3) Typing: typing/{chatId} = { who, ts }
    match /typing/{chatId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['who', 'ts'])
                   && request.resource.data.who is string
                   && request.resource.data.who.size() <= 40
                   && request.resource.data.ts is number;
    }

    // 4) Public Friend Code directory: WP1 payload -> current display profile.
    match /friendCodes/{code} {
      allow read: if true;
      allow write: if code.size() == 8
                   && request.resource.data.keys().hasOnly(['code', 'name', 'color', 'updatedAt'])
                   && request.resource.data.code == code
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 40
                   && request.resource.data.color is string
                   && request.resource.data.color.size() <= 16
                   && request.resource.data.updatedAt is number;
    }

    // 5) First-contact requests: friendRequests/{targetCode}/items/{senderCode}.
    match /friendRequests/{targetCode}/items/{senderCode} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if targetCode.size() == 8
                            && senderCode.size() == 8
                            && targetCode != senderCode
                            && request.resource.data.keys().hasOnly(
                              ['code', 'name', 'color', 'preview', 'ts'])
                            && request.resource.data.code == senderCode
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.color is string
                            && request.resource.data.color.size() <= 16
                            && request.resource.data.preview is string
                            && request.resource.data.preview.size() <= 160
                            && request.resource.data.ts is number;
    }

    function isValidMsg(d) {
      return d.keys().hasAll(['from', 'text', 'ts'])
        && d['from'] is string && d['from'].size() <= 40
        && d['text'] is string && d['text'].size() <= 4000
        && d['ts'] is number;
    }
  }
}
